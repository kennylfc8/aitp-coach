coach_sample.*
*.mp3
*.ogg
*.wav
# ...but the web demo's test audio IS part of the app — keep it
!web/public/coach_test.mp3

# Debug / tooling artifacts
web_debug.log
.playwright-mcp/

# Downloaded test video clips (large, throwaway)
samples/
*.mp4
# Claude Design export duplicate (folder is committed, zip is not)
\# AI Tennis Coach Terminal.zip

# 3D source assets — heavy originals not used by the app at runtime.
# The app ships web/public/Ch28w.glb (resized) + web/public/anims/*.glb only.
3dModels/
web/public/*.fbx
web/public/Ch28.glb
web/public/Brute.glb
web/public/Xbot.glb
web/public/RobotExpressive.glb

# Rhubarb Lip Sync CLI (3rd-party binary + sphinx models, ~30MB) — download:
# https://github.com/DanielSWolf/rhubarb-lip-sync/releases -> extract into tools/
# (tools/* + negation: our own tools/retarget stays in git, 3rd-party dumps don't)
tools/*
!tools/retarget/
tools/retarget/node_modules/
